{
  "name": "nomux-echo-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "Example nomux extension in TypeScript: the conformance extension of the TypeScript SDK",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@nomux/extension": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
